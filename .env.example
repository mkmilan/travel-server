# Copy to .env for LOCAL DEVELOPMENT ONLY. Never copy production credentials.
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/travel_development
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
EXPO_URL=http://localhost:8081
# Supply a separate local-only signing secret through an approved secret workflow.
# Intentionally blank: no credential is committed or generated by this setup.
JWT_SECRET=
JWT_COOKIE_EXPIRE=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
APP_NAME=Travel Local Development
# SMTP credentials intentionally omitted: NODE_ENV=development uses the no-send stub.
